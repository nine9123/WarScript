<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless native-call trace of a mod's scripts, for the behavior baseline (T0.9). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on whatever newer .NET runtime is installed when 8.0 itself is not. -->
    <RollForward>Major</RollForward>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WarScript.ModTrace</AssemblyName>
    <RootNamespace>WarScript.ModTrace</RootNamespace>
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../Runtime/WarScript.Runtime.csproj" />
  </ItemGroup>
</Project>
