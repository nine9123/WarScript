<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one-time v1 -> v2 migration tool (T3.2, plan 8.2). Temporary: delete once every script is migrated (plan 8.3). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on whatever newer .NET runtime is installed when 8.0 itself is not. -->
    <RollForward>Major</RollForward>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WarScript.Migrate</AssemblyName>
    <RootNamespace>WarScript.Migrate</RootNamespace>
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Migrator.cs" />
    <ProjectReference Include="../../Headless~/Runtime/WarScript.Runtime.csproj" />
  </ItemGroup>
</Project>
